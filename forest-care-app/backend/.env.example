# Backend environment variables
# Copy this file to .env and fill in real values.
#
# Why dotenv matters:
#   Node.js does not read .env automatically. Without dotenv, DATABASE_URL
#   (and every other variable here) would be undefined at runtime.  pg
#   requires the password to be a string, so an undefined value triggers:
#     "SASL: SCRAM-SERVER-FIRST-MESSAGE: client password must be a string"
#
# Credentials must match docker-compose.yml:
#   POSTGRES_USER=postgres  POSTGRES_PASSWORD=password  POSTGRES_DB=forest_care

PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/forest_care
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
