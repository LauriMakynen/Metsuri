# Backend environment variables
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/forest_care
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
# Password for local test accounts admin@metsuri.test / yrittaja@metsuri.test (npm run seed).
# start.sh generates a random one if this is empty. Never use in production.
SEED_PASSWORD=
# Primary frontend URL for CORS and password-reset links
FRONTEND_URL=http://localhost:5173
# Additional exact frontend origins for CORS, comma-separated (e.g. Vercel preview domains)
FRONTEND_URLS=
# Outgoing email. Leave SMTP_HOST empty in development: mail goes to Mailpit
# (docker compose, view at http://localhost:8025). In production use e.g. Resend or Brevo SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Metsuri <noreply@metsuri.local>
MML_API_KEY=
# Include {propertyCode} placeholder. Use canonical (14-digit) kiinteistotunnus.
# Example:
# https://avoin-paikkatieto.maanmittauslaitos.fi/kiinteisto-avoin/simple-features/v3/collections/PalstanSijaintitiedot/items?kiinteistotunnus={propertyCode}
MML_CADASTRE_API_URL=https://avoin-paikkatieto.maanmittauslaitos.fi/kiinteisto-avoin/simple-features/v3/collections/PalstanSijaintitiedot/items?kiinteistotunnus={propertyCode}
# Forest parcel value ("Metsäpalstan arvo")
# 'mock' uses generated stands (no Metsäkeskus calls), 'live' queries the WFS below.
# If unset: live when METSAKESKUS_WFS_URL is set, otherwise mock.
FOREST_DATA_MODE=mock
# Suomen metsäkeskus open forest resource data, WFS 2.0 (v1 is retired end of June 2027)
METSAKESKUS_WFS_URL=https://avoin.metsakeskus.fi/rajapinnat/v2/stand/ows
METSAKESKUS_WFS_TYPENAME=v2:stand
# Luke stumpage prices (PxWeb). Empty = use backend/src/config/fallbackStumpagePrices.json
LUKE_PXWEB_PRICE_URL=https://statdb.luke.fi/PxWeb/api/v1/fi/LUKE/met/teokau/kk/0100_teokau.px
# How long a computed parcel value is reused before the APIs are queried again
FOREST_VALUE_CACHE_HOURS=24
